# Dibuat scripts/bootstrap.sh (mode 600 root). JANGAN commit .env.
DATABASE_URL=postgresql://umami:<PG_UMAMI_PASSWORD dari /opt/infra/postgres/.env>@postgres:5432/umami
# JANGAN diubah setelah ada data (hash sesi/token Umami) — ikut backup restic `files`.
APP_SECRET=<openssl rand -hex 32>
# 64 hex (AES-256-GCM rahasia TOTP 2FA). Mengganti nilai = semua 2FA yang sudah aktif tidak bisa didekripsi.
TWO_FACTOR_ENCRYPTION_KEY=<openssl rand -hex 32>
