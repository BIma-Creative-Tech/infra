# Dibuat oleh /opt/infra/scripts/odoo-pool-bootstrap.sh (mode 600 root). JANGAN commit .env.
PGHOST=postgres
PGPORT=5432
PGUSER=<odoo_pool_a|odoo_staging>
PGPASSWORD=<disalin dari postgres/.env PG_ODOO_*_PASSWORD>
# hash pbkdf2_sha512 dari secrets/master-password, dalam kutip tunggal (compose tidak menginterpolasi '$')
ODOO_ADMIN_PASSWD='<$pbkdf2-sha512$600000$...>'
