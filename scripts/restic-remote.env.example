# Placeholder repo restic OFFSITE (L4, ADR 0006) — BELUM AKTIF (keputusan user #7: S3 belum dipilih).
# Dipasang role Ansible `backup` ke /etc/restic/remote.env (600 root) HANYA bila file itu belum ada;
# isi di host, JANGAN di git. scripts/backup.sh menjalankan `restic copy` hanya bila
# RESTIC_REPOSITORY_REMOTE terisi dan bukan placeholder (<...>); selain itu log "REMOTE NOT CONFIGURED".
#
# Format repo S3 (restic 0.19.1 doc/030_preparing_a_new_repo.rst): s3:https://<endpoint>/<bucket>
RESTIC_REPOSITORY_REMOTE=
# Password repo remote (file terpisah, 600 root; boleh berbeda dari repo lokal).
RESTIC_PASSWORD_FILE_REMOTE=/etc/restic/password-remote
# Kredensial S3 — key dengan scope satu bucket saja (ADR 0006 §Security).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
