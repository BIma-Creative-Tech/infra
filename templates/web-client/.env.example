# Contoh .env stack website client — DIBUAT OTOMATIS oleh scripts/provision-web-client.sh (600 root, tidak di git).
# Diisi manual hanya untuk uji `docker compose config`. Tidak ada secret di file ini (password SMTP = file secret).
COMPOSE_PROJECT_NAME=web-<slug>-<env>
# docker-compose.yml saja (default) — atau docker-compose.yml:docker-compose.contact.yml bila --contact
COMPOSE_FILE=docker-compose.yml
WEB_CONTAINER=web-<slug>-<env>
# Tag pin atau digest; `latest` / tanpa tag ditolak skrip. Contoh: ghcr.io/bctech-adm/web-<slug>:<tag>
WEB_IMAGE=ghcr.io/bctech-adm/web-<slug>:<tag>
SITE_URL=https://<host>
CONTACT_ENABLED=false
# Hanya bila --contact (docker-compose.contact.yml):
# SMTP_HOST=mail.bimacreative.tech
# SMTP_PORT=587
# SMTP_USER=<mailbox>@<domain>
# SMTP_FROM_ADDRESS=<mailbox>@<domain>
