# identity/keycloak/.env — dibuat scripts/bootstrap.sh (mode 600, TIDAK di-commit).
# Password DB = PG_KEYCLOAK_PASSWORD dari /opt/infra/postgres/.env.
KC_DB_PASSWORD=<dari postgres/.env>
# Admin bootstrap SEMENTARA (hanya dipakai saat realm master pertama kali dibuat).
# Hapus kedua baris setelah admin permanen dibuat & admin sementara dihapus (docs/03-operations/keycloak.md).
KC_BOOTSTRAP_ADMIN_USERNAME=<temp-admin>
KC_BOOTSTRAP_ADMIN_PASSWORD=<acak ≥32 char>
