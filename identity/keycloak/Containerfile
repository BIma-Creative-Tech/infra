# T06 — image Keycloak teroptimasi (docs 26.7.4 guides/server/containers.adoc).
# Opsi build-time (diverifikasi `kc.sh build --help` 26.7.4): db, health-enabled, metrics-enabled.
# Base di-pin tag + digest index (ADR 0001, diambil 2026-09-23; 26.7.5 2026-10-04 — K11, 13 CVE; changelog JPA: +1 changeset backfill ORG_ID, 0 baris;
# 26.8.1 2026-10-17 — review CVE: 20+ CVE Keycloak + Trivy 0 CRIT/HIGH; panduan upgrade 26.8 dicek terhadap setup kita).
FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244 AS builder
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
# 26.8: scim-api aktif default — tidak dipakai di platform ini, dimatikan (kurangi permukaan /realms/*/scim).
ENV KC_FEATURES_DISABLED=scim-api
WORKDIR /opt/keycloak
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244
COPY --from=builder /opt/keycloak/ /opt/keycloak/
# Eksplisit: base image upstream sudah USER 1000 (docker inspect 2026-09-24); dinyatakan ulang
# agar tidak bergantung pada default base (Trivy DS-0002). Tidak mengubah perilaku runtime.
USER 1000
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
