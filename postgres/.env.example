# Salin ke .env (mode 600 root) — atau jalankan scripts/bootstrap.sh yang membangkitkan
# nilai acak dengan `openssl rand`. JANGAN commit .env.
POSTGRES_PASSWORD=<acak-min-32-char>
PG_KEYCLOAK_PASSWORD=<acak-min-32-char>
PG_CONTROL_PLANE_PASSWORD=<acak-min-32-char>
PG_DATAMART_PASSWORD=<acak-min-32-char>
PG_ODOO_POOL_A_PASSWORD=<acak-min-32-char>
PG_ODOO_STAGING_PASSWORD=<acak-min-32-char>
# ProyekKas client DRMS (role <db>_{owner,app,ro}; dibuat scripts/init-roles.sh)
PG_PK_DRMS_OWNER_PASSWORD=<acak-min-32-char>
PG_PK_DRMS_APP_PASSWORD=<acak-min-32-char>
PG_PK_DRMS_RO_PASSWORD=<acak-min-32-char>
PG_PK_DRMS_STG_OWNER_PASSWORD=<acak-min-32-char>
PG_PK_DRMS_STG_APP_PASSWORD=<acak-min-32-char>
PG_PK_DRMS_STG_RO_PASSWORD=<acak-min-32-char>
# Plan 11 / ADR 0013 — Umami web analytics (owner DB umami)
PG_UMAMI_PASSWORD=<acak-min-32-char>
