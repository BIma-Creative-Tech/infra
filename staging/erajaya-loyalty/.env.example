# erajaya-loyalty STAGING — copy to .env (root:root 0600, NOT in git). No secrets here: secrets live in ./secrets/*.secret.
# Image built from the app repo (Dockerfile target `runner`); pin an explicit tag, never `latest` (CLAUDE.md §0.12).
WEB_IMAGE=erajaya-loyalty:dev-<sha>
# Optional, only for `docker compose --profile seed run --rm erajaya-staging-seed` (Dockerfile target `seed`).
SEED_IMAGE=erajaya-loyalty-seed:dev-<sha>
SEED_ADMIN_EMAIL=admin@example.invalid
NEXT_PUBLIC_SITE_URL=https://erajaya-loyalty.staging.bimacreative.tech
# TEMPORARY(2026-10-07): staging demo only (user-approved) — OTP shown in UI/logs. Default false.
OTP_DEV_MODE=true

# ./secrets/ (1001:1001 0400, no trailing newline):
#   database_uri.secret          postgres://erajaya_loyalty_stg:<PG_ERAJAYA_LOYALTY_STG_PASSWORD>@postgres:5432/erajaya_loyalty_stg
#   payload_secret.secret        random (openssl rand -hex 32)
#   app_encryption_key.secret    EXACTLY 64 hex chars (openssl rand -hex 32) — AES-256-GCM key for POS terminal secrets;
#                                rotating it makes stored terminal secrets unreadable (re-issue terminal keys)
#   member_session_secret.secret random (openssl rand -hex 32) — rotating logs all members out / invalidates QR tokens
#   cron_secret.secret           random (openssl rand -hex 32) — also read by the host timer erajaya-staging-expire
#   seed_admin_password.secret   random (seed profile only)
