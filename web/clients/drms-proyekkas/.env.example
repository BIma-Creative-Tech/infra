# ProyekKas PROD (client DRMS) — TEMPLATE .env (TANPA secret). Salin ke .env (600 root) di
# /opt/infra/web/clients/drms-proyekkas/ lalu isi nilai <...>. Secret TIDAK di sini: ./secrets/*.secret
# (1001:1001 0400, tanpa newline) — daftar & sumber: docs/runbooks/proyekkas-drms-prod.md §3.

# --- images (WAJIB GHCR + digest; tag semver, tag lama = jalur rollback) ---
PK_WEB_IMAGE=ghcr.io/bctech-adm/proyekkas-web:<X.Y.Z>@sha256:<digest-64-hex>
PK_MIGRATE_IMAGE=ghcr.io/bctech-adm/proyekkas-migrate:<X.Y.Z>@sha256:<digest-64-hex>

# --- app ---
APP_URL=https://drms-kas.bimacreative.tech
LOG_LEVEL=info

# --- Keycloak (realm drms, PROD) ---
OIDC_ISSUER=https://auth.bimacreative.tech/realms/drms
OIDC_WEB_CLIENT_ID=proyekkas-web
OIDC_MOBILE_CLIENT_ID=proyekkas-mobile
KC_ADMIN_BASE_URL=https://auth.bimacreative.tech
KC_REALM=drms
KC_ADMIN_CLIENT_ID=proyekkas-admin-api

# --- SMTP (password: secrets/smtp_password.secret) ---
SMTP_HOST=mail.bimacreative.tech
SMTP_PORT=587
SMTP_USER=<mailbox-prod>@bimacreative.tech
SMTP_FROM_ADDRESS=<mailbox-prod>@bimacreative.tech
SMTP_FROM_NAME=ProyekKas

# --- Android App Links (publik, bukan secret) — fingerprint kunci rilis PROD (E3-c), bukan kunci staging ---
ANDROID_APP_PACKAGE=id.co.drms.proyekkas
ANDROID_APP_CERT_SHA256=<AA:BB:...>

# --- fitur ---
EXPORT_XLSX_ENABLED=true
PUSH_FCM_ENABLED=false

# --- seed (hanya untuk `--profile seed run`, kosongkan setelah bootstrap admin) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_KEYCLOAK_SUB=
SEED_DATA_FILE=
