# Dipasang ke /etc/logrotate.d/traefik oleh traefik/scripts/bootstrap.sh.
# Traefik membuka ulang file log saat menerima USR1 (docs v3.7 logs-and-accesslogs.md §Log Rotation).
# H7: sinyal dikirim lewat `docker exec … kill -USR1 1`, BUKAN `docker kill --signal=USR1` — `docker kill`
# (sinyal apa pun) men-set HasBeenManuallyStopped=true + membatalkan restart manager (moby v29.8.1
# daemon/kill.go killWithSignal) → container tidak start lagi setelah reboot (docs/03-operations/traefik.md).
/opt/infra/traefik/logs/*.log {
    daily
    rotate 14
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    # tanpa `create`: setelah rename, Traefik (uid 65532) membuat file baru sendiri saat USR1.
    su root root
    sharedscripts
    postrotate
        /usr/bin/docker exec traefik kill -USR1 1 >/dev/null 2>&1 || true
    endscript
}
