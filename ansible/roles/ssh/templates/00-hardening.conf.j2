# {{ ansible_managed }}
# Drop-in hardening sshd — plan 01 §4/§5. Nama 00-* agar dibaca sebelum 50-cloud-init.conf
# (sshd: nilai PERTAMA yang menang). Fase: {{ ssh_render_phase }}
{% if ssh_render_phase in ['a', 'b'] %}
Port {{ ssh_port_legacy }}
{% endif %}
Port {{ ssh_port_new }}
{% if ssh_render_phase == 'c' and ssh_keep_legacy_port | default(false) %}
Port {{ ssh_port_legacy }}
{% endif %}
{% if ssh_render_phase in ['b', 'c'] %}
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AllowUsers {{ ssh_allow_users | join(' ') }}
MaxAuthTries {{ ssh_max_auth_tries }}
LoginGraceTime {{ ssh_login_grace_time }}
X11Forwarding no
AllowAgentForwarding no
{% endif %}
{% if ssh_render_phase == 'c' %}
# H1 (Lead): user CI `deploy` tanpa forwarding TCP/Unix-socket dan tanpa PTY — lapisan sshd di atas
# opsi `restrict` authorized_keys (man sshd AUTHORIZED_KEYS). Keyword diizinkan di Match (man
# sshd_config §Match). Blok Match WAJIB paling akhir: berlaku sampai EOF file ini (diuji: tidak
# bocor ke sshd_config utama — sshd -t lolos, `sshd -T -C user=admin` tetap default).
Match User {{ deploy_user }}
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    PermitTTY no
{% endif %}
