# {{ ansible_managed }} — role backup (T13, ADR 0006). 600 root. Tanpa secret: password lewat file.
# PERINGATAN: kehilangan {{ restic_password_file }} = seluruh backup TIDAK BISA DIBACA.
# Simpan salinan isinya di password manager user (docs/03-operations/backup.md).
RESTIC_REPOSITORY={{ restic_repository }}
RESTIC_PASSWORD_FILE={{ restic_password_file }}
RESTIC_CACHE_DIR={{ restic_cache_dir }}
# Dibaca scripts/backup.sh (dipisah spasi; path/pola tanpa spasi).
INFRA_BACKUP_EXTRA_PATHS="{{ restic_extra_paths | default([]) | join(' ') }}"
INFRA_BACKUP_EXTRA_EXCLUDES="{{ restic_extra_excludes | default([]) | join(' ') }}"
