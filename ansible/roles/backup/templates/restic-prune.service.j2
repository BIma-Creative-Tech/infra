# {{ ansible_managed }} — role backup (T13, ADR 0006)
[Unit]
Description=Retensi restic (forget --prune 7d/4w/3m) + check
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart={{ infra_root }}/scripts/backup.sh prune
# Hasil/ringkasan ke journal: journalctl -u restic-prune.service
SyslogIdentifier=restic-prune
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=6h
