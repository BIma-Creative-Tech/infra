# {{ ansible_managed }} — role healthcheck (H7). TANPA secret: password SMTP dibaca dari ALERT_PASSWORD_FILE.
# Dibaca scripts/infra-healthcheck.sh (parser KEY=VALUE, bukan `source`). Ganti penerima lewat group_vars
# `infra_alert_to` lalu `ansible-playbook site.yml --tags healthcheck` (docs/03-operations/observability.md §Healthcheck).
ALERT_TO={{ infra_alert_to }}
ALERT_FROM={{ infra_alert_from }}
ALERT_SMTP_HOST={{ infra_alert_smtp_host }}
ALERT_SMTP_PORT={{ infra_alert_smtp_port }}
ALERT_PASSWORD_FILE={{ infra_root }}/mail/secrets/{{ infra_alert_from }}.password
HC_STATE_DIR={{ healthcheck_state_dir }}
HC_REPEAT_MINUTES={{ infra_alert_repeat_minutes }}
HC_STACKS={{ healthcheck_stacks | join(' ') }}
HC_UNITS={{ healthcheck_units | join(' ') }}
