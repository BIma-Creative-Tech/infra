## {{ ansible_managed }}
## plan 01 §4 auditd. Watch path yang belum ada diperbolehkan selama direktori induk ada.
-w /etc/ssh/ -p wa -k sshd_config
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/docker/ -p wa -k docker_config
-w /etc/restic/ -p wa -k restic_config
-w {{ deploy_wrapper_path }} -p wa -k infra_deploy
## plan 05 §3.2 (ADR 0009): dispatcher root job control plane + konfigurasi/kill switch-nya.
-w /usr/local/sbin/infra-job -p wa -k infra_job
-w /etc/infra-jobs/ -p wa -k infra_job_config
-w /usr/bin/docker -p x -k docker_exec
-w /usr/bin/sudo -p x -k sudo_exec
